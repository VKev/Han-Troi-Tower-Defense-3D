TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 144914494}
  m_Text: 'This scene demonstrates the ''Dynamic Skinned Collider'' component.

    This
    generates and updates a collider for skinned and animated meshes.


    Press
    ''Play'' to see it in action.


    Click the ''Ellen'' game object to see how
    it is configured.


    For even greater performance, you can use it with Mesh
    Lods

    (added in Unity 6.1). Generate lods in the import settings for the

    skinned
    mesh, then select a LOD level on the

    DynamicSkinnedCollider component.


    For
    more detail see the Technie docs.'
  m_OffsetZ: 0
  m_CharacterSize: 1
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 45
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
